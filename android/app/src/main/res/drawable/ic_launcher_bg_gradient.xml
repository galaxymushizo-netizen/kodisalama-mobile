<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon background. Mirrors the green tile used by the legacy mipmaps
     and the PWA icons: #066e2a at the bottom-left rising to #40e860 at the
     top-right, i.e. the same BackwardDiagonal gradient housemark.ps1 paints. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="45"
        android:startColor="#066e2a"
        android:endColor="#40e860"
        android:type="linear" />
</shape>

<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon background. Mirrors the green tile used by the legacy mipmaps
     and the PWA icons (#dcfce7 -> #86efac, top-left to bottom-right), so the
     dark-green key reads crisply against it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#dcfce7"
        android:endColor="#86efac"
        android:type="linear" />
</shape>

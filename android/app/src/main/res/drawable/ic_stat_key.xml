<?xml version="1.0" encoding="utf-8"?>
<!-- Status-bar icon for local notifications: a white key (funguo). Android
     tint-notification icons to white, so the path must be solid white. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <group
        android:pivotX="12"
        android:pivotY="12"
        android:rotation="-45">

        <!-- donut head: outer circle r=4.6 minus inner circle r=2.7 -->
        <path
            android:fillColor="#FFFFFFFF"
            android:fillType="evenOdd"
            android:pathData="M2.6,12 a4.6,4.6 0 1,0 9.2,0 a4.6,4.6 0 1,0 -9.2,0 Z M4.5,12 a2.7,2.7 0 1,0 5.4,0 a2.7,2.7 0 1,0 -5.4,0 Z" />

        <!-- shaft -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M7.2,11 L21,11 L21,13 L7.2,13 Z" />

        <!-- teeth -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M15.6,13 L17.4,13 L17.4,16 L15.6,16 Z" />
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M18.2,13 L20,13 L20,15.2 L18.2,15.2 Z" />
    </group>
</vector>

{
  "name": "kodisalama",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "icons": "powershell -ExecutionPolicy Bypass -File scripts/make-icons.ps1",
    "icons:android": "powershell -ExecutionPolicy Bypass -File scripts/make-android-assets.ps1",
    "sync": "npm run build && npm run version:android && cap sync android",
    "version:android": "powershell -ExecutionPolicy Bypass -File scripts/sync-android-version.ps1",
    "apk": "npm run build && npm run version:android && cap sync android && cd android && gradlew assembleDebug",
    "apk:release": "npm run build && npm run version:android && cap sync android && cd android && gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor/android": "^8.5.3",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/react-leaflet": "^2.8.3",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "vite-plugin-pwa": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
